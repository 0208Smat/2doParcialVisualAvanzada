    {
      "name": "1. Registrar Categoria",
      "request": {
        "method": "POST",
        "header": [],
        "auth": {
          "type": "noauth"
        },
        "description": "",
        "url": {
          "raw": "{{baseUrl}}/api/categorias",
          "protocol": "",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "categorias"
          ],
          "query": [],
          "variable": []
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Cat Test {{testSufijo}}\",\n  \"descripcion\": \"Categoría generada para pruebas automatizadas\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "packages": {},
            "requests": {},
            "exec": [
              "// Generar un sufijo aleatorio para evitar conflictos de nombres al correr múltiples veces",
              "const uuid = require('crypto').randomUUID().substring(0, 6);",
              "pm.variables.set(\"testSufijo\", uuid);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "packages": {},
            "requests": {},
            "exec": [
              "// Tests",
              "pm.test(\"Debe retornar 201 Created\", function() {",
              "  pm.expect(pm.response.code).to.equal(201);",
              "});",
              "",
              "pm.test(\"Debe devolver el ID de la nueva categoría\", function() {",
              "  pm.expect(pm.response.json().id).to.be.a(\"number\");",
              "});"
            ]
          }
        }
      ]
    },
